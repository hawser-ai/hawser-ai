{
  "$defs": {
    "ContextSpec": {
      "additionalProperties": false,
      "description": "What a ``call_model`` node may see (blueprint §13).",
      "properties": {
        "include_nodes": {
          "items": {
            "type": "string"
          },
          "title": "Include Nodes",
          "type": "array"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 500,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "pages": {
          "anyOf": [
            {
              "enum": [
                "all",
                "matching"
              ],
              "type": "string"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          ],
          "default": "all",
          "title": "Pages"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        }
      },
      "title": "ContextSpec",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "body": {
          "items": {
            "type": "string"
          },
          "title": "Body",
          "type": "array"
        },
        "branches": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Branches",
          "type": "array"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "context": {
          "$ref": "#/$defs/ContextSpec",
          "default": {
            "include_nodes": [],
            "inputs": [],
            "max_tokens": null,
            "pages": "all",
            "query": null
          }
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "else": {
          "items": {
            "type": "string"
          },
          "title": "Else",
          "type": "array"
        },
        "expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expression"
        },
        "id": {
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "instruction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruction"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "max_attempts": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Attempts"
        },
        "max_iterations": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Iterations"
        },
        "max_parallel": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Parallel"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "result": {
          "default": null,
          "title": "Result"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "success",
                "failure"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "then": {
          "items": {
            "type": "string"
          },
          "title": "Then",
          "type": "array"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        },
        "validators": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/ValidatorConfig"
              }
            ]
          },
          "title": "Validators",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Node",
      "type": "object"
    },
    "NodeKind": {
      "enum": [
        "call_tool",
        "call_model",
        "compute",
        "branch",
        "loop",
        "parallel",
        "validate",
        "review",
        "repair",
        "exit"
      ],
      "title": "NodeKind",
      "type": "string"
    },
    "ValidatorConfig": {
      "additionalProperties": false,
      "description": "A validator by id with parameters, e.g. ``rules.expressions`` with ``rules``.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "ValidatorConfig",
      "type": "object"
    }
  },
  "$id": "https://hawser.dev/schemas/0.1.0/Plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "goal": {
      "title": "Goal",
      "type": "string"
    },
    "inputs": {
      "items": {
        "type": "string"
      },
      "title": "Inputs",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "goal",
    "nodes"
  ],
  "title": "Plan",
  "type": "object",
  "x-hawser-contract-version": "0.1.0"
}
