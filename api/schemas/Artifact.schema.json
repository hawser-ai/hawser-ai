{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "original",
        "rendered_page",
        "crop",
        "mask",
        "annotation",
        "transcript",
        "index",
        "table",
        "report",
        "redacted",
        "clip",
        "generated",
        "sandbox_output",
        "step_output",
        "eval_report",
        "other"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactMeta": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "media": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "default": {},
          "title": "Media",
          "type": "object"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "parents": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "retain_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retain Until"
        },
        "scoped_hash": {
          "title": "Scoped Hash",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "transform": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "crop": "#/$defs/CropTransform",
                  "dpi": "#/$defs/DpiTransform",
                  "exif_orient": "#/$defs/ExifOrientTransform",
                  "pad": "#/$defs/PadTransform",
                  "rotate": "#/$defs/RotateTransform",
                  "scale": "#/$defs/ScaleTransform",
                  "time_offset": "#/$defs/TimeOffsetTransform"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/CropTransform"
                },
                {
                  "$ref": "#/$defs/ScaleTransform"
                },
                {
                  "$ref": "#/$defs/RotateTransform"
                },
                {
                  "$ref": "#/$defs/ExifOrientTransform"
                },
                {
                  "$ref": "#/$defs/PadTransform"
                },
                {
                  "$ref": "#/$defs/DpiTransform"
                },
                {
                  "$ref": "#/$defs/TimeOffsetTransform"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transform"
        }
      },
      "required": [
        "kind",
        "media_type",
        "size_bytes",
        "content_hash",
        "scoped_hash",
        "producer"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "CropTransform": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "kind": {
          "const": "crop",
          "default": "crop",
          "title": "Kind",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "CropTransform",
      "type": "object"
    },
    "DpiTransform": {
      "additionalProperties": false,
      "description": "PDF points → pixels at a given DPI (72 points per inch).",
      "properties": {
        "dpi": {
          "exclusiveMinimum": 0,
          "title": "Dpi",
          "type": "number"
        },
        "kind": {
          "const": "dpi",
          "default": "dpi",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "dpi"
      ],
      "title": "DpiTransform",
      "type": "object"
    },
    "ExifOrientTransform": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "exif_orient",
          "default": "exif_orient",
          "title": "Kind",
          "type": "string"
        },
        "orientation": {
          "maximum": 8,
          "minimum": 1,
          "title": "Orientation",
          "type": "integer"
        }
      },
      "required": [
        "orientation"
      ],
      "title": "ExifOrientTransform",
      "type": "object"
    },
    "PadTransform": {
      "additionalProperties": false,
      "properties": {
        "bottom": {
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "kind": {
          "const": "pad",
          "default": "pad",
          "title": "Kind",
          "type": "string"
        },
        "left": {
          "minimum": 0,
          "title": "Left",
          "type": "number"
        },
        "right": {
          "minimum": 0,
          "title": "Right",
          "type": "number"
        },
        "top": {
          "minimum": 0,
          "title": "Top",
          "type": "number"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "title": "PadTransform",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "ProducerRef": {
      "additionalProperties": false,
      "description": "What produced an artifact, evidence item or result: a tool, a model or the runtime.",
      "properties": {
        "config_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Hash"
        },
        "kind": {
          "enum": [
            "tool",
            "model",
            "system"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "ProducerRef",
      "type": "object"
    },
    "RotateTransform": {
      "additionalProperties": false,
      "properties": {
        "about": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "degrees": {
          "title": "Degrees",
          "type": "number"
        },
        "kind": {
          "const": "rotate",
          "default": "rotate",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "degrees"
      ],
      "title": "RotateTransform",
      "type": "object"
    },
    "ScaleTransform": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "scale",
          "default": "scale",
          "title": "Kind",
          "type": "string"
        },
        "sx": {
          "exclusiveMinimum": 0,
          "title": "Sx",
          "type": "number"
        },
        "sy": {
          "exclusiveMinimum": 0,
          "title": "Sy",
          "type": "number"
        }
      },
      "required": [
        "sx",
        "sy"
      ],
      "title": "ScaleTransform",
      "type": "object"
    },
    "TimeOffsetTransform": {
      "additionalProperties": false,
      "description": "Output time t maps to input time ``t + offset_ms`` (for clips and chunks).",
      "properties": {
        "kind": {
          "const": "time_offset",
          "default": "time_offset",
          "title": "Kind",
          "type": "string"
        },
        "offset_ms": {
          "title": "Offset Ms",
          "type": "integer"
        }
      },
      "required": [
        "offset_ms"
      ],
      "title": "TimeOffsetTransform",
      "type": "object"
    }
  },
  "$id": "https://hawser.dev/schemas/0.1.0/Artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "step_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step Id"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "meta",
    "created_at"
  ],
  "title": "Artifact",
  "type": "object",
  "x-hawser-contract-version": "0.1.0"
}
