{
  "$defs": {
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "additionalProperties": true,
          "default": {},
          "title": "Details",
          "type": "object"
        },
        "evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "field": {
          "anyOf": [
            {
              "pattern": "^(?:/(?:[^/~]|~0|~1)*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "repair": {
          "$ref": "#/$defs/RepairKind",
          "default": "none"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Version"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "id",
        "rule_id",
        "severity",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "RepairKind": {
      "description": "What the runtime may try for a repairable issue (blueprint §16).",
      "enum": [
        "retrieve",
        "reocr",
        "remodel",
        "ask_field",
        "recalculate",
        "reexecute",
        "review",
        "none"
      ],
      "title": "RepairKind",
      "type": "string"
    },
    "RuleRun": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "issues": {
          "minimum": 0,
          "title": "Issues",
          "type": "integer"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "rule_id",
        "duration_ms",
        "issues"
      ],
      "title": "RuleRun",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "https://hawser.dev/schemas/0.1.0/ValidationReport.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "rules_run": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuleRun"
      },
      "title": "Rules Run",
      "type": "array"
    }
  },
  "title": "ValidationReport",
  "type": "object",
  "x-hawser-contract-version": "0.1.0"
}
