{
  "$defs": {
    "ApprovalPolicy": {
      "additionalProperties": false,
      "properties": {
        "pre_approved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Pre Approved",
          "type": "array"
        },
        "require_for_external_write": {
          "default": true,
          "title": "Require For External Write",
          "type": "boolean"
        }
      },
      "title": "ApprovalPolicy",
      "type": "object"
    },
    "EvidenceRequirements": {
      "additionalProperties": false,
      "properties": {
        "preferred": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Preferred",
          "type": "array"
        },
        "required": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        }
      },
      "title": "EvidenceRequirements",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "direct",
        "workflow",
        "agent"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "FallbackPolicy": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidates"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "FallbackPolicy",
      "type": "object"
    },
    "InputType": {
      "enum": [
        "document",
        "image",
        "audio",
        "video",
        "text",
        "json",
        "any"
      ],
      "title": "InputType",
      "type": "string"
    },
    "Limits": {
      "additionalProperties": false,
      "description": "Hard caps. ``None`` means \"use the deployment default\".",
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Input Tokens"
        },
        "max_loop_iterations": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Loop Iterations"
        },
        "max_media_duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Media Duration Ms"
        },
        "max_model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Calls"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "max_pages": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Pages"
        },
        "max_parallel": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Parallel"
        },
        "max_pixels": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Pixels"
        },
        "max_plan_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Plan Steps"
        },
        "max_sampled_frames": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Sampled Frames"
        },
        "max_sandbox_runs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Sandbox Runs"
        },
        "max_tool_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tool Calls"
        },
        "max_wall_time_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Time S"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "PlanningPolicy": {
      "additionalProperties": false,
      "properties": {
        "cache": {
          "default": true,
          "title": "Cache",
          "type": "boolean"
        },
        "context_tokens": {
          "anyOf": [
            {
              "minimum": 500,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Tokens"
        },
        "max_replans": {
          "default": 2,
          "minimum": 0,
          "title": "Max Replans",
          "type": "integer"
        }
      },
      "title": "PlanningPolicy",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "allow_public_urls": {
          "default": false,
          "title": "Allow Public Urls",
          "type": "boolean"
        },
        "allowed_models": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Models"
        },
        "allowed_providers": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Providers"
        },
        "allowed_tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Tools"
        },
        "approvals": {
          "$ref": "#/$defs/ApprovalPolicy",
          "default": {
            "pre_approved": [],
            "require_for_external_write": true
          }
        },
        "code_mode": {
          "default": "disabled",
          "enum": [
            "disabled",
            "enabled"
          ],
          "title": "Code Mode",
          "type": "string"
        },
        "fallback": {
          "$ref": "#/$defs/FallbackPolicy",
          "default": {
            "candidates": null,
            "enabled": true
          }
        },
        "generation": {
          "default": "disabled",
          "enum": [
            "disabled",
            "enabled"
          ],
          "title": "Generation",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/Limits",
          "default": {
            "max_cost_usd": null,
            "max_input_tokens": null,
            "max_loop_iterations": null,
            "max_media_duration_ms": null,
            "max_model_calls": null,
            "max_output_tokens": null,
            "max_pages": null,
            "max_parallel": null,
            "max_pixels": null,
            "max_plan_steps": null,
            "max_sampled_frames": null,
            "max_sandbox_runs": null,
            "max_tool_calls": null,
            "max_wall_time_s": null
          }
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "planning": {
          "$ref": "#/$defs/PlanningPolicy",
          "default": {
            "cache": true,
            "context_tokens": null,
            "max_replans": 2
          }
        },
        "privacy": {
          "$ref": "#/$defs/PrivacyPolicy",
          "default": {
            "allowed_regions": null,
            "no_data_retention": false,
            "no_hosted": false
          }
        },
        "repair": {
          "$ref": "#/$defs/RepairPolicy",
          "default": {
            "attempts": 1,
            "max_cost_usd": null,
            "max_seconds": null
          }
        },
        "review_on_failure": {
          "default": true,
          "title": "Review On Failure",
          "type": "boolean"
        },
        "validation": {
          "$ref": "#/$defs/ValidationPolicy",
          "default": {
            "allow_model_judges": false,
            "downgrade": {},
            "escalate": {},
            "max_unknown_fraction": null
          }
        }
      },
      "title": "Policy",
      "type": "object"
    },
    "PrivacyPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_regions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Regions"
        },
        "no_data_retention": {
          "default": false,
          "title": "No Data Retention",
          "type": "boolean"
        },
        "no_hosted": {
          "default": false,
          "title": "No Hosted",
          "type": "boolean"
        }
      },
      "title": "PrivacyPolicy",
      "type": "object"
    },
    "RepairPolicy": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": 1,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Seconds"
        }
      },
      "title": "RepairPolicy",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SkillExample": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "inputs",
        "expected"
      ],
      "title": "SkillExample",
      "type": "object"
    },
    "SkillInput": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "multiple": {
          "default": false,
          "title": "Multiple",
          "type": "boolean"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/InputType"
        }
      },
      "required": [
        "type"
      ],
      "title": "SkillInput",
      "type": "object"
    },
    "SkillModels": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed"
        },
        "preferred": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred"
        }
      },
      "title": "SkillModels",
      "type": "object"
    },
    "ValidationPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_model_judges": {
          "default": false,
          "title": "Allow Model Judges",
          "type": "boolean"
        },
        "downgrade": {
          "additionalProperties": {
            "$ref": "#/$defs/Severity"
          },
          "default": {},
          "title": "Downgrade",
          "type": "object"
        },
        "escalate": {
          "additionalProperties": {
            "$ref": "#/$defs/Severity"
          },
          "default": {},
          "title": "Escalate",
          "type": "object"
        },
        "max_unknown_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Unknown Fraction"
        }
      },
      "title": "ValidationPolicy",
      "type": "object"
    },
    "ValidatorConfig": {
      "additionalProperties": false,
      "description": "A validator by id with parameters, e.g. ``rules.expressions`` with ``rules``.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "ValidatorConfig",
      "type": "object"
    }
  },
  "$id": "https://hawser.dev/schemas/0.1.0/SkillManifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compatibility": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compatibility"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "evals": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evals",
      "type": "array"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceRequirements",
      "default": {
        "preferred": [],
        "required": []
      }
    },
    "examples": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SkillExample"
      },
      "title": "Examples",
      "type": "array"
    },
    "inputs": {
      "additionalProperties": {
        "$ref": "#/$defs/SkillInput"
      },
      "title": "Inputs",
      "type": "object"
    },
    "instruction": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instruction"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "models": {
      "$ref": "#/$defs/SkillModels",
      "default": {
        "allowed": null,
        "preferred": null
      }
    },
    "name": {
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Name",
      "type": "string"
    },
    "output_schema": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "string"
        }
      ],
      "title": "Output Schema"
    },
    "policy": {
      "$ref": "#/$defs/Policy",
      "default": {
        "allow_public_urls": false,
        "allowed_models": null,
        "allowed_providers": null,
        "allowed_tools": null,
        "approvals": {
          "pre_approved": [],
          "require_for_external_write": true
        },
        "code_mode": "disabled",
        "fallback": {
          "candidates": null,
          "enabled": true
        },
        "generation": "disabled",
        "limits": {
          "max_cost_usd": null,
          "max_input_tokens": null,
          "max_loop_iterations": null,
          "max_media_duration_ms": null,
          "max_model_calls": null,
          "max_output_tokens": null,
          "max_pages": null,
          "max_parallel": null,
          "max_pixels": null,
          "max_plan_steps": null,
          "max_sampled_frames": null,
          "max_sandbox_runs": null,
          "max_tool_calls": null,
          "max_wall_time_s": null
        },
        "mode": null,
        "planning": {
          "cache": true,
          "context_tokens": null,
          "max_replans": 2
        },
        "privacy": {
          "allowed_regions": null,
          "no_data_retention": false,
          "no_hosted": false
        },
        "repair": {
          "attempts": 1,
          "max_cost_usd": null,
          "max_seconds": null
        },
        "review_on_failure": true,
        "validation": {
          "allow_model_judges": false,
          "downgrade": {},
          "escalate": {},
          "max_unknown_fraction": null
        }
      }
    },
    "prompts": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Prompts",
      "type": "object"
    },
    "tools": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    },
    "validators": {
      "default": [],
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/ValidatorConfig"
          }
        ]
      },
      "title": "Validators",
      "type": "array"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "name",
    "version",
    "description",
    "inputs",
    "output_schema",
    "mode"
  ],
  "title": "SkillManifest",
  "type": "object",
  "x-hawser-contract-version": "0.1.0"
}
