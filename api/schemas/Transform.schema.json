{
  "$defs": {
    "CropTransform": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "kind": {
          "const": "crop",
          "default": "crop",
          "title": "Kind",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "CropTransform",
      "type": "object"
    },
    "DpiTransform": {
      "additionalProperties": false,
      "description": "PDF points → pixels at a given DPI (72 points per inch).",
      "properties": {
        "dpi": {
          "exclusiveMinimum": 0,
          "title": "Dpi",
          "type": "number"
        },
        "kind": {
          "const": "dpi",
          "default": "dpi",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "dpi"
      ],
      "title": "DpiTransform",
      "type": "object"
    },
    "ExifOrientTransform": {
      "additionalProperties": false,
      "description": "The EXIF orientation applied to make a ``width`` x ``height`` image upright.",
      "properties": {
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "kind": {
          "const": "exif_orient",
          "default": "exif_orient",
          "title": "Kind",
          "type": "string"
        },
        "orientation": {
          "maximum": 8,
          "minimum": 1,
          "title": "Orientation",
          "type": "integer"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "orientation"
      ],
      "title": "ExifOrientTransform",
      "type": "object"
    },
    "PadTransform": {
      "additionalProperties": false,
      "properties": {
        "bottom": {
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "kind": {
          "const": "pad",
          "default": "pad",
          "title": "Kind",
          "type": "string"
        },
        "left": {
          "minimum": 0,
          "title": "Left",
          "type": "number"
        },
        "right": {
          "minimum": 0,
          "title": "Right",
          "type": "number"
        },
        "top": {
          "minimum": 0,
          "title": "Top",
          "type": "number"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "title": "PadTransform",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "RotateTransform": {
      "additionalProperties": false,
      "properties": {
        "about": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "degrees": {
          "title": "Degrees",
          "type": "number"
        },
        "kind": {
          "const": "rotate",
          "default": "rotate",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "degrees"
      ],
      "title": "RotateTransform",
      "type": "object"
    },
    "ScaleTransform": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "scale",
          "default": "scale",
          "title": "Kind",
          "type": "string"
        },
        "sx": {
          "exclusiveMinimum": 0,
          "title": "Sx",
          "type": "number"
        },
        "sy": {
          "exclusiveMinimum": 0,
          "title": "Sy",
          "type": "number"
        }
      },
      "required": [
        "sx",
        "sy"
      ],
      "title": "ScaleTransform",
      "type": "object"
    },
    "TimeOffsetTransform": {
      "additionalProperties": false,
      "description": "Output time t maps to input time ``t + offset_ms`` (for clips and chunks).",
      "properties": {
        "kind": {
          "const": "time_offset",
          "default": "time_offset",
          "title": "Kind",
          "type": "string"
        },
        "offset_ms": {
          "title": "Offset Ms",
          "type": "integer"
        }
      },
      "required": [
        "offset_ms"
      ],
      "title": "TimeOffsetTransform",
      "type": "object"
    }
  },
  "$id": "https://hawser.dev/schemas/0.1.0/Transform.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "crop": "#/$defs/CropTransform",
      "dpi": "#/$defs/DpiTransform",
      "exif_orient": "#/$defs/ExifOrientTransform",
      "pad": "#/$defs/PadTransform",
      "rotate": "#/$defs/RotateTransform",
      "scale": "#/$defs/ScaleTransform",
      "time_offset": "#/$defs/TimeOffsetTransform"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/CropTransform"
    },
    {
      "$ref": "#/$defs/ScaleTransform"
    },
    {
      "$ref": "#/$defs/RotateTransform"
    },
    {
      "$ref": "#/$defs/ExifOrientTransform"
    },
    {
      "$ref": "#/$defs/PadTransform"
    },
    {
      "$ref": "#/$defs/DpiTransform"
    },
    {
      "$ref": "#/$defs/TimeOffsetTransform"
    }
  ],
  "title": "Transform",
  "x-hawser-contract-version": "0.1.0"
}
