{
  "$defs": {
    "ApprovalPolicy": {
      "additionalProperties": false,
      "properties": {
        "pre_approved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Pre Approved",
          "type": "array"
        },
        "require_for_external_write": {
          "default": true,
          "title": "Require For External Write",
          "type": "boolean"
        }
      },
      "title": "ApprovalPolicy",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "direct",
        "workflow",
        "agent"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "FallbackPolicy": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidates"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "FallbackPolicy",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "description": "Hard caps. ``None`` means \"use the deployment default\".",
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Input Tokens"
        },
        "max_loop_iterations": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Loop Iterations"
        },
        "max_media_duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Media Duration Ms"
        },
        "max_model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Calls"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "max_pages": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Pages"
        },
        "max_parallel": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Parallel"
        },
        "max_pixels": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Pixels"
        },
        "max_plan_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Plan Steps"
        },
        "max_sampled_frames": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Sampled Frames"
        },
        "max_sandbox_runs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Sandbox Runs"
        },
        "max_tool_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tool Calls"
        },
        "max_wall_time_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Time S"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "PlanningPolicy": {
      "additionalProperties": false,
      "properties": {
        "cache": {
          "default": true,
          "title": "Cache",
          "type": "boolean"
        },
        "context_tokens": {
          "anyOf": [
            {
              "minimum": 500,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Tokens"
        },
        "max_replans": {
          "default": 2,
          "minimum": 0,
          "title": "Max Replans",
          "type": "integer"
        }
      },
      "title": "PlanningPolicy",
      "type": "object"
    },
    "PrivacyPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_regions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Regions"
        },
        "no_data_retention": {
          "default": false,
          "title": "No Data Retention",
          "type": "boolean"
        },
        "no_hosted": {
          "default": false,
          "title": "No Hosted",
          "type": "boolean"
        }
      },
      "title": "PrivacyPolicy",
      "type": "object"
    },
    "RepairPolicy": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": 1,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Seconds"
        }
      },
      "title": "RepairPolicy",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "ValidationPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_model_judges": {
          "default": false,
          "title": "Allow Model Judges",
          "type": "boolean"
        },
        "downgrade": {
          "additionalProperties": {
            "$ref": "#/$defs/Severity"
          },
          "default": {},
          "title": "Downgrade",
          "type": "object"
        },
        "escalate": {
          "additionalProperties": {
            "$ref": "#/$defs/Severity"
          },
          "default": {},
          "title": "Escalate",
          "type": "object"
        },
        "max_unknown_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Unknown Fraction"
        }
      },
      "title": "ValidationPolicy",
      "type": "object"
    }
  },
  "$id": "https://hawser.dev/schemas/0.1.0/Policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_public_urls": {
      "default": false,
      "title": "Allow Public Urls",
      "type": "boolean"
    },
    "allowed_models": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Allowed Models"
    },
    "allowed_providers": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Allowed Providers"
    },
    "allowed_tools": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Allowed Tools"
    },
    "approvals": {
      "$ref": "#/$defs/ApprovalPolicy",
      "default": {
        "pre_approved": [],
        "require_for_external_write": true
      }
    },
    "code_mode": {
      "default": "disabled",
      "enum": [
        "disabled",
        "enabled"
      ],
      "title": "Code Mode",
      "type": "string"
    },
    "fallback": {
      "$ref": "#/$defs/FallbackPolicy",
      "default": {
        "candidates": null,
        "enabled": true
      }
    },
    "generation": {
      "default": "disabled",
      "enum": [
        "disabled",
        "enabled"
      ],
      "title": "Generation",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/Limits",
      "default": {
        "max_cost_usd": null,
        "max_input_tokens": null,
        "max_loop_iterations": null,
        "max_media_duration_ms": null,
        "max_model_calls": null,
        "max_output_tokens": null,
        "max_pages": null,
        "max_parallel": null,
        "max_pixels": null,
        "max_plan_steps": null,
        "max_sampled_frames": null,
        "max_sandbox_runs": null,
        "max_tool_calls": null,
        "max_wall_time_s": null
      }
    },
    "mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionMode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "planning": {
      "$ref": "#/$defs/PlanningPolicy",
      "default": {
        "cache": true,
        "context_tokens": null,
        "max_replans": 2
      }
    },
    "privacy": {
      "$ref": "#/$defs/PrivacyPolicy",
      "default": {
        "allowed_regions": null,
        "no_data_retention": false,
        "no_hosted": false
      }
    },
    "repair": {
      "$ref": "#/$defs/RepairPolicy",
      "default": {
        "attempts": 1,
        "max_cost_usd": null,
        "max_seconds": null
      }
    },
    "review_on_failure": {
      "default": true,
      "title": "Review On Failure",
      "type": "boolean"
    },
    "validation": {
      "$ref": "#/$defs/ValidationPolicy",
      "default": {
        "allow_model_judges": false,
        "downgrade": {},
        "escalate": {},
        "max_unknown_fraction": null
      }
    }
  },
  "title": "Policy",
  "type": "object",
  "x-hawser-contract-version": "0.1.0"
}
