{
  "$defs": {
    "ReviewDecision": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "field": {
          "pattern": "^(?:/(?:[^/~]|~0|~1)*)*$",
          "title": "Field",
          "type": "string"
        },
        "new": {
          "default": null,
          "title": "New"
        },
        "old": {
          "default": null,
          "title": "Old"
        },
        "reviewer": {
          "title": "Reviewer",
          "type": "string"
        }
      },
      "required": [
        "field",
        "reviewer",
        "at"
      ],
      "title": "ReviewDecision",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "open",
        "approved",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "$id": "https://hawser.dev/schemas/0.1.0/Review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assigned_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assigned To"
    },
    "comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "decided_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided By"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/ReviewDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "open"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "run_id",
    "tenant_id",
    "created_at",
    "updated_at"
  ],
  "title": "Review",
  "type": "object",
  "x-hawser-contract-version": "0.1.0"
}
